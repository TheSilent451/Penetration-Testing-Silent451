Download the Public Key:
You need to obtain the Public Key from your Keycloak server which is usually available at https://<your-keycloak-server>/realms/<realm-name>/.well-known/jwks.json. This JSON file contains all the keys including the public key.

How to Use This Script
Replace <your-keycloak-server> with your actual Keycloak server URL.
Replace <realm-name> with your realm name
Set the public_key_id variable to match the key ID you need.





Generate JWT Using Python:

import requests
import jwt

# Fetch the JWKS (JSON Web Key Set)
response = requests.get("https://<your-keycloak-server>/realms/<realm-name>/.well-known/jwks.json")
jwks_data = response.json()

# Find your specific key by its kid (Key ID)
public_key_id = "<your-key-id>"
keys = [k for k in jwks_data['keys'] if k['kid'] == public_key_id]
if not keys:
    print("No matching key found")
    exit(1)

key_data = keys[0]

# Generate JWT
token_payload = {
    'sub': '<user-identifier>',
    'iat': int(time.time()),
    'exp': int(time.time()) + 3600, # expires in one hour
}

jwt_token = jwt.encode(
    token_payload,
    public_key_id, 
    algorithm='RS256',
    headers={
        'kid': key_data['kid'],
        'alg': 'RS256'
    }
)

print("JWT:", jwt_token)








#!/usr/bin/env python3
"""
Generate signed JWT using Keycloak-style RSA keys.
"""

import time, requests, sys, json

def get_keys(realm_url='https://auth-server.com/auth', realm_name='master'):
    """Get JWKS from server."""
    url = f"{realm_url}/realms/{realm_name}/.well-known/jwks.json"
    
    try:
        response = requests.get(url)
        return response.json()['keys']
    except Exception as e:
        sys.exit(f"Error fetching keys: {e}")

def generate_token(payload, realm_url='https://auth-server.com/auth', 
                   realm_name='master'):
    """Generate signed JWT token."""
    
    # Find first valid key
    jwks = get_keys(realm_url, realm_name)
    
    if not jwks:
        sys.exit("No keys found!")
        
    kid = jwks[0]['kid']
    
    # Generate payload with expiry time (in seconds since epoch)
    payload['iat'] = int(time.time())
    payload['exp'] = payload.get('exp', payload['iat'] + 3600)  # Default: 1 hour
    
    # Try to import jwt library
    try:
        from jose import jwt, jwk
        
        key_data = next(k for k in jwks if k['kid'] == kid)
        
        return jwt.encode(
            payload,
            key_data['n'], 
            algorithm='RS256',
            headers={
                'kid': kid,
                'alg': 'RS256'
            }
        )
    
    except ImportError:
        print("Install the python-jose package to generate JWTs")
        sys.exit(1)

if __name__ == "__main__":
    if len(sys.argv) < 3:
        sys.exit(f"Usage: {sys.argv[0]} 'user_id' [realm_url] [realm_name]")
    
    user = sys.argv[1]
    realm_url = sys.argv[2] if len(sys.argv) > 2 else None
    realm_name = sys.argv[3] if len(sys.argv) > 3 else "master"
    
    payload = {
        'sub': user,
        # Additional claims here (like name, email, etc.)
    }
    
    token = generate_token(payload, realm_url or '', realm_name)
    
    print(f"Generated Token: {token}")






